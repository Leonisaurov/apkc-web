# binarios: se construyen, nunca se versionan (mismo criterio que en ../apkc)
*.wasm
*.o
*.obj
# el `go build .` dentro de apkc/ deja un ELF de 7.8 MB con el nombre del modulo: eso es lo que se
# col6 en el commit 1f04ff1, y la regla 2 del repo lo prohibe
apkc/apkc
apkc/apkc.exe

# wasm_exec.js viene del GOROOT de quien lo corre: cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" …
# (shim/ lo monta el gate y studio/ la prueba de pestana; ninguno de los dos lo versiona)
shim/wasm_exec.js
studio/wasm_exec.js

node_modules/
.DS_Store
*.log

# planes y ajustes locales de los agentes: no son del repo
.hermes/
.qoder/
